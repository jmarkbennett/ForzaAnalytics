<UserControl x:Class="ForzaAnalytics.Controls.GenericStatMetric"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ForzaAnalytics.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="300">
    <Grid Width="300" Height="60">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="4"></ColumnDefinition>
            <ColumnDefinition Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Label Name="lMetricTitle" Content="{Binding StatTitle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
         Grid.Row="0" Style="{StaticResource StatLabel}">
        </Label>
        <Image Name="iStatIcon" Grid.Column="0" HorizontalAlignment="Left" 
               Source="{Binding StatIcon, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Margin="16 4" Height="16" Width="16"></Image>

        <Label Grid.Column="2" Name="lMetricValue" Style="{StaticResource StatValue}"></Label>
        <Rectangle Grid.ColumnSpan="3" Height="60" Stroke="#444444" Width="300" RadiusX="4" RadiusY="4" StrokeThickness="4"/>
    </Grid>
    
</UserControl>
