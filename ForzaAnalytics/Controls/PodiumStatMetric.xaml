<UserControl x:Class="ForzaAnalytics.Controls.PodiumStatMetric"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ForzaAnalytics.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Width="180" Height="180">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="8"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Label Grid.Column="1" Grid.Row="3" Grid.RowSpan="4" Background="Silver" Content="2nd"  Style="{StaticResource PodiumLabel}"></Label>
        <Label Grid.Column="2" Grid.Row="1" Grid.RowSpan="6" Background="Gold" Content="1st"    Style="{StaticResource PodiumLabel}"></Label>
        <Label Grid.Column="3" Grid.Row="5" Grid.RowSpan="2" Background="Orange" Content="3rd"  Style="{StaticResource PodiumLabel}"></Label>

        <Label Grid.Column="2" Name="l1stValue" Padding="0" Margin="4 2" Style="{StaticResource StatValue}"></Label>
        <Label Grid.Column="1" Name="l2ndValue" Padding="0" Margin="4 2" Style="{StaticResource StatValue}"></Label>
        <Label Grid.Column="3" Name="l3rdValue" Padding="0" Margin="4 2" Style="{StaticResource StatValue}"></Label>

    </Grid>
    
</UserControl>
