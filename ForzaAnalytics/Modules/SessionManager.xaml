<UserControl x:Class="ForzaAnalytics.Modules.SessionManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ForzaAnalytics.Modules"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1920">
    <UserControl.Resources>
        <Style x:Key="ImportantText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Background="#CC444444">
        <Grid DockPanel.Dock="Top" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="180"></ColumnDefinition>
                <ColumnDefinition Width="40"></ColumnDefinition>
                <ColumnDefinition Width="180"></ColumnDefinition>
                <ColumnDefinition Width="40"></ColumnDefinition>
                <ColumnDefinition Width="180"></ColumnDefinition>
                <ColumnDefinition Width="40"></ColumnDefinition>
                <ColumnDefinition Width="180"></ColumnDefinition>
                <ColumnDefinition Width="180"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Close Current Session:" HorizontalAlignment="Right" Margin="12 0" VerticalContentAlignment="Center"></Label>
            <Button Grid.Column="1"  Margin="2" Name="btnAbandonSession" Click="btnAbandonSession_Click">
                <StackPanel Orientation="Horizontal">
                <Label Content="Abandon Session*" Foreground="Black"></Label>
                <Image Source="../Resources/Icons/exit.png" Margin="8 4" Height="16" Width="16"></Image>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Margin="2" Name="btnCompleteSession"  Click="btnCompleteSession_Click">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Complete Session*" Foreground="Black"></Label>
                    <Image Source="../Resources/Icons/checkered-flag.png" Margin="8 4" Height="16" Width="16"></Image>
                </StackPanel>
            </Button>

            <Button Grid.Column="5" Margin="2" Name="btnCompleteRaceSession"  Click="btnCompleteRaceSession_Click">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Complete Race Session*" Foreground="Black"></Label>
                    <Image Source="../Resources/Icons/checkered-flag.png" Margin="8 4" Height="16" Width="16"></Image>
                </StackPanel>
            </Button>

            <Label Grid.Column="7" Content="Export Session Data:" HorizontalAlignment="Right" Margin="12 0" VerticalContentAlignment="Center"></Label>
            <Button Grid.Column="8" Margin="2" Name="btnExport" Click="btnExport_Click">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Export" Foreground="Black"></Label>
                    <Image Source="../Resources/Icons/file-excel.png" Margin="8 4" Height="16" Width="16"></Image>
                </StackPanel>
            </Button>

        </Grid>
        <Label DockPanel.Dock="Top"  Style="{StaticResource HeaderLabel}" Grid.Row="0" Content="Session Summary"></Label>
        <ListView DockPanel.Dock="Top"  Name="lvLapTimes" Style="{StaticResource LeaderboardView}">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="Transparent"></Setter>
                            <Setter Property="FontSize" Value="16"></Setter>
                            <Setter Property="Foreground" Value="White"></Setter>
                            <Setter Property="BorderBrush" Value="Transparent"></Setter>
                            <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
                            <Setter Property="Padding" Value="6 0 0 0"></Setter>
                            <Setter Property="Height" Value="34"></Setter>
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridView.Columns>
                        <GridViewColumn Header="Lap Number" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=LapNumber}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Time" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedLapTime}" Style="{StaticResource LeaderboardLapTimeLabel}">
                                    </Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Race Position" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=RacePosition}" Style="{StaticResource LeaderboardLapTimeLabel}">
                                    </Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Fuel Remaining" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedFuelRemaining}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Avg. Tyre Wear" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition Width="100"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <ProgressBar Grid.Column="0" Height="15" Width="10" Grid.Row="0" Value="{Binding Path=FlTyreRemaining}" Minimum="0" Maximum="100" Margin="2"  ToolTip="{Binding Path=FlTyreRemaining}" Foreground="White" Background="Black"  Orientation="Vertical"></ProgressBar>
                                        <ProgressBar Grid.Column="1" Height="15" Width="10" Grid.Row="0" Value="{Binding Path=FrTyreRemaining}" Minimum="0" Maximum="100" Margin="2"  ToolTip="{Binding Path=FrTyreRemaining}" Foreground="White" Background="Black"  Orientation="Vertical" ></ProgressBar>
                                        <ProgressBar Grid.Column="0" Height="15" Width="10" Grid.Row="1" Value="{Binding Path=RlTyreRemaining}" Minimum="0" Maximum="100" Margin="2"  ToolTip="{Binding Path=RlTyreRemaining}" Foreground="White" Background="Black" Orientation="Vertical" ></ProgressBar>
                                        <ProgressBar Grid.Column="1" Height="15" Width="10"  Grid.Row="1" Value="{Binding Path=RrTyreRemaining}" Minimum="0" Maximum="100" Margin="2" ToolTip="{Binding Path=RrTyreRemaining}" Foreground="White" Background="Black"  Orientation="Vertical"></ProgressBar>
                                        <Label Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Margin="4 0" Content="{Binding Path=FormattedTyreRemaining}" Style="{StaticResource LeaderboardLapTimeLabel}" Background="Transparent" ></Label>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Avg. Speed" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedAverageSpeed}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="% Full Throttle" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedPercentFullThrottle}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="% Brake" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedPercentBrakeApplied}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="% Coasting" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedPercentCoasting}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Min Speed" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedMinSpeed}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Max Speed" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedMaxSpeed}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Fuel Used" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedFuelUsed}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Lap Distance" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedDistanceTravelled}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Total Distance" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Path=FormattedTotalDistanceTravelled}" Style="{StaticResource LeaderboardLapTimeLabel}"></Label>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Label Content="{Binding Name}" Style="{StaticResource SessionDetailSummary}"></Label>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>
    </DockPanel>
</UserControl>
