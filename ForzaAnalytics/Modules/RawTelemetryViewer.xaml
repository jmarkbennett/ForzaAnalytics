<UserControl x:Class="ForzaAnalytics.Modules.RawTelemetryViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ForzaAnalytics.Modules"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1920">
    <UserControl.Resources>
        <Style x:Key="ImportantText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Background="#CC444444">
        <Label DockPanel.Dock="Top"  Style="{StaticResource HeaderLabel}" Grid.Row="0" Content="Telemetry Log"></Label>
        <Button DockPanel.Dock="Top" Height="30" Width="120" Content="Clear" Name="btnClear" Click="btnClear_Click"></Button>
        <TextBox DockPanel.Dock="Top" Name="tbOutput" HorizontalContentAlignment="Left" VerticalScrollBarVisibility="Visible"></TextBox>
       
    </DockPanel>
</UserControl>
